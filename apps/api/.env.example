# 服务端口
PORT=3001

# 前端来源（CORS），多个用逗号分隔（含 Vite 备用端口 5174）
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# 信任的前置代理跳数。浏览器流量经 Next 的 /bff 转发，需要它才能从
# X-Forwarded-For 还原真实客户端 IP 用于限流。BFF 直连后端时为 1；
# 若 BFF 前面还有 Nginx / CDN，按实际层数增加；后端直接暴露则设 0。
TRUST_PROXY_HOPS=1

# PostgreSQL 连接串（可用根目录 docker-compose 一键启动）
DATABASE_URL="postgresql://wabao:wabao@localhost:5432/wabao?schema=public"

# JWT 密钥与有效期
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600

# OpenAI（留空则后端自动进入 mock 模式，返回模拟流式内容，方便本地无 Key 运行）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ===== P2 图像与多模态（M5）=====
# 文生图模型（留空用默认 gpt-image-1）；未配置 OPENAI_API_KEY 时生成渐变 SVG 占位图
OPENAI_IMAGE_MODEL=gpt-image-1
# 图像理解（看图问答）模型
OPENAI_VISION_MODEL=gpt-4o-mini
# 媒体文件磁盘根目录（相对后端工作目录），由 /uploads 静态托管
MEDIA_ROOT=uploads
# 可公网访问的媒体地址前缀。做真实图像理解时上游模型需要能访问图片，
# 本地开发可用内网穿透地址；留空则返回相对路径。
MEDIA_PUBLIC_BASE_URL=

# ===== 支付 =====
# mock：下单后自动确认（本地 / e2e）；接入微信/支付宝/Stripe 后改为对应渠道名
PAYMENT_PROVIDER=mock
# 支付 Webhook 共享密钥。mock 未配置时放行；正式渠道必须配置并在回调头带 x-wabao-signature
PAYMENT_WEBHOOK_SECRET=

# ===== 运维加固 =====
# 媒体签名密钥（缺省回退 JWT_ACCESS_SECRET）。强制签名后猜中文件名也无法匿名读取
MEDIA_SIGNING_SECRET=
# 签名链接有效期（秒）
MEDIA_URL_TTL_SECONDS=3600
# true=必须带有效签名才能读 /uploads；本地若要裸链调试可设 false
MEDIA_REQUIRE_SIGNED=true
# 可选。配置后限流计数走 Redis，多副本共享；留空则用进程内内存
REDIS_URL=
